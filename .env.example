# 运行模式
# auto: 有 API Key 时调用 API，失败时回退到本地模板 / Edge TTS
# api: 必须使用 API；demo: 强制使用本地演示
PIPELINE_MODE=auto

# ---- Web 服务 ----
# Web 端同时运行的任务数（排队生成）；生图与合成较吃资源，建议 1~2
WEB_MAX_CONCURRENT_TASKS=2

# ---- 硅基流动 SiliconFlow（OpenAI 兼容接口）----
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.siliconflow.cn/v1

# 文档/文案书写（内容规划）模型
PLANNER_MODEL=deepseek-ai/DeepSeek-V4-Flash
# 生图前用大模型把画面描述扩写成更具体的英文提示词（true/false）
PROMPT_ENHANCE=true
# 提示词扩充用哪个模型；留空则跟 PLANNER_MODEL 相同
PROMPT_ENHANCE_MODEL=

# 生图：IMAGE_BACKEND=openai 时调用上面 base_url 的 /images/generations
# demo=本地演示画面；openai=OpenAI 兼容生图（接 SiliconFlow）；comfyui=本地 ComfyUI
IMAGE_BACKEND=openai
# 生图模型：Qwen-Image；备选 Tongyi-MAI/Z-Image、Tongyi-MAI/Z-Image-Turbo、Kwai-Kolors/Kolors
IMAGE_MODEL=Qwen/Qwen-Image
# SiliconFlow 生图尺寸，格式 宽x高；16:9 可用 1344x768、1280x720、1024x576
IMAGE_SIZE=1344x768
# 画面内是否包含中文文字 / 图表 / 逻辑图（true/false）；本地 SDXL 中文易乱码，可关闭
IMAGE_TEXT=true

# ---- 生图后自动质检重画（IMAGE_BACKEND=openai/comfyui 且已配置 API Key 时生效）----
QC_ENABLED=true
# 质检用的视觉大模型（需支持图片输入，SiliconFlow 实惠款 Qwen/Qwen3-VL-8B-Instruct）
QC_MODEL=Qwen/Qwen3-VL-8B-Instruct
# 质检通过分数线（0-10），低于该分数会重画
QC_MIN_SCORE=6.0
# 每页最多重画次数
QC_MAX_REDRAWS=2

# 配音固定使用 Edge TTS（免费）；换声音 / 语速改下面两行
EDGE_TTS_VOICE=zh-CN-XiaoxiaoNeural
EDGE_TTS_RATE=+0%

# 本地 ComfyUI 后端（IMAGE_BACKEND=comfyui 时生效）
# 工作流使用“Save (API Format)”导出的 JSON，支持占位符：
# {{prompt}}/{{positive_prompt}}、{{negative_prompt}}、{{width}}、{{height}}、{{seed}}
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_WORKFLOW_FILE=
COMFYUI_OUTPUT_NODE_ID=
COMFYUI_TIMEOUT_SECONDS=300
COMFYUI_POLL_INTERVAL_SECONDS=0.5

# 视频参数
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
FPS=30
PAGE_AUDIO_TAIL_SECONDS=0.65
# 是否把解说字幕烧录到画面底部（true/false）
BURN_SUBTITLES=true
# 是否在幻灯片切换时加淡入淡出过渡（true/false）
SLIDE_TRANSITIONS=true
# 是否在画面右下角显示“AI 辅助生成画面”标识（true/false）
AI_DISCLOSURE=false

# 可选：背景音乐路径；留空则不混入
BACKGROUND_MUSIC=
BACKGROUND_MUSIC_VOLUME=0.10

# 可选费用估算，单位人民币；只按你填的单价估算用量，不联网查实时价格。
# 填 0 则该项费用为 0；示例（仅供参考，以服务商实时价格为准）：
#   EST_PLANNER_CNY_PER_CALL=0.02   （文案模型每次调用）
#   EST_IMAGE_CNY_PER_IMAGE=0.20    （生图每张）
#   EST_TTS_CNY_PER_1K_CHARS=0      （Edge TTS 免费，保持 0）
#   EST_QC_CNY_PER_CALL=0.005       （质检视觉模型每次调用）
EST_PLANNER_CNY_PER_CALL=0
EST_IMAGE_CNY_PER_IMAGE=0
EST_TTS_CNY_PER_1K_CHARS=0
EST_QC_CNY_PER_CALL=0

